---
import { withBase } from '../lib/urls';
import type { CollectionEntry } from 'astro:content';
import { Image } from 'astro:assets';
import ProjectVisual from './ProjectVisual.astro';
import Icon from './Icon.astro';
interface Props { project: CollectionEntry<'projects'>; featured?: boolean; breakTitle?: boolean; }
const { project, featured = false, breakTitle = false } = Astro.props;
const d = project.data;
// With breakTitle, "… for DTU RoadRunners Solar Car/EcoCar" titles put the team name on its own line.
const split = ['DTU RoadRunners Solar Car', 'DTU RoadRunners EcoCar'].find(t => d.title.includes(t)) ?? '';
const titleLines = breakTitle && split ? [d.title.split(split)[0].trimEnd(), split] : [d.title];
const detail = d.stage === 'case-study';
const collaboration = { individual: 'Individual', group: 'Group', team: 'Team' }[d.collaboration ?? (d.team ? 'group' : 'individual')];
const labels: Record<string,string> = {aerodynamics:'Aerodynamics',mechanical:'Mechanical',numerical:'Modelling',experiments:'Experiments',electronics:'Electronics',energy:'Energy'};
---
<article class:list={['project-card',{'featured-card':featured}]} data-project-card data-tags={d.tags.join(' ')} data-search={`${d.title} ${d.description} ${d.technologies.join(' ')} ${d.type} ${d.period || ''}`.toLowerCase()}>
  {detail ? <a href={withBase(`/projects/${project.id}/`)} class="card-media" aria-label={`Read case study: ${d.title}`}>
    {d.cover ? <Image src={d.cover.src} alt={d.cover.alt} class:list={[{ "cover-top": d.cover.fit === "contain" }]} widths={[480, 960]} sizes="(max-width: 600px) 100vw, (max-width: 800px) 50vw, 420px"/> : <ProjectVisual kind={d.visual} uid={`${featured?'f':'p'}-${project.id}`}/>}
    <span class="card-index">{d.projectId}</span><span class="card-corner"><Icon name="northeast"/></span>
  </a> : <button type="button" class="card-media" data-open-project={project.id} aria-haspopup="dialog" aria-label={`View project: ${d.title}`}>
    {d.cover ? <Image src={d.cover.src} alt={d.cover.alt} class:list={[{ "cover-top": d.cover.fit === "contain" }]} widths={[480, 960]} sizes="(max-width: 600px) 100vw, (max-width: 800px) 50vw, 420px"/> : <ProjectVisual kind={d.visual} uid={`${featured?'f':'p'}-${project.id}`}/>}
    <span class="card-index">{d.projectId}</span><span class="card-corner"><Icon name="northeast"/></span>
  </button>}
  <div class="card-meta"><span>{d.type} · {collaboration}</span>{d.period && <span>{d.period}</span>}</div>
  <h3>{detail ? <a href={withBase(`/projects/${project.id}/`)}>{titleLines.map((t,i)=><>{i>0&&<br/>}{t}</>)}</a> : <button type="button" data-open-project={project.id} aria-haspopup="dialog">{titleLines.map((t,i)=><>{i>0&&<br/>}{t}</>)}</button>}</h3>
  <p>{d.description}</p>
  <div class="card-bottom"><ul class="tag-list" aria-label="Disciplines">{d.tags.slice(0,3).map(t=><li>{labels[t]||t}</li>)}</ul>{detail && <a class="case-label" href={withBase(`/projects/${project.id}/`)}>Case study <Icon name="arrow" size={15}/></a>}</div>
</article>
