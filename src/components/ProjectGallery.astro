---
import type { ImageMetadata } from 'astro';
import { Image, getImage } from 'astro:assets';
import { withBase } from '../lib/urls';
interface Props { images: {src?: ImageMetadata; video?: string | string[]; alt: string; caption: string; stack?: boolean}[]; label?: string; title?: string; }
const { images, label = 'THE WORK IN PICTURES', title = 'Design. Build. Measure.' } = Astro.props;
// The thumbnail is sized for the grid; the link points to a larger version for the enlarged view.
// A video item plays in place and only loads when played.
const items = await Promise.all(images.map(async im => ({ ...im, large: im.src ? await getImage({ src: im.src, width: Math.min(im.src.width, 2000) }) : undefined })));
// An image with `stack: true` shares a grid cell with the image before it (for two wide, low images).
const cells: (typeof items)[] = [];
items.forEach(im => { if (im.stack && cells.length) cells[cells.length - 1].push(im); else cells.push([im]); });
---
{items.length>0 && <section class="project-gallery" aria-labelledby="gallery-heading"><p class="eyebrow">{label.toUpperCase()}</p><h2 id="gallery-heading">{title}</h2><div class="gallery-grid">{cells.map(cell=>{const figs=cell.map(im=>im.video?<figure><video controls preload="metadata" playsinline aria-label={im.alt}>{[im.video].flat().map(v=><source src={withBase(v)} type={v.endsWith('.webm')?'video/webm':'video/mp4'}/>)}</video><figcaption>{im.caption}</figcaption></figure>:<figure><a href={im.large!.src} data-gallery-image data-caption={im.caption} data-alt={im.alt} aria-label={`Enlarge: ${im.alt}`}><Image src={im.src!} alt={im.alt} widths={[600, 1200]} sizes="(max-width: 600px) 100vw, 640px"/></a><figcaption>{im.caption}</figcaption></figure>);return cell.length>1?<div class="gallery-stack">{figs}</div>:figs;})}</div><dialog class="image-dialog" aria-label="Enlarged project image"><button class="icon-button" data-close-image aria-label="Close image">×</button><img alt=""/><p></p></dialog></section>}
<script>
  const imageDialog=document.querySelector<HTMLDialogElement>('.project-gallery .image-dialog');
  document.querySelectorAll<HTMLAnchorElement>('[data-gallery-image]').forEach(link=>link.addEventListener('click',e=>{
    if(!imageDialog)return;e.preventDefault();const img=imageDialog.querySelector('img')!;img.src=link.href;img.alt=link.dataset.alt||'';imageDialog.querySelector('p')!.textContent=link.dataset.caption||'';imageDialog.showModal();
  }));
  imageDialog?.querySelector('[data-close-image]')?.addEventListener('click',()=>imageDialog.close());
  imageDialog?.addEventListener('click',e=>{if(e.target===imageDialog)imageDialog.close();});
</script>
