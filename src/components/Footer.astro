---
import { withBase } from '../lib/urls';
import { profile } from '../data/profile';
import Icon from './Icon.astro';
---
<footer class="site-footer">
  <div class="container">
    <div class="footer-top"><div><p class="eyebrow">LET’S CONNECT</p><h2>Have an engineering<br/>challenge in mind?</h2></div><a class="footer-email" href={`mailto:${profile.email}`}>Get in touch <Icon name="northeast" size={28}/></a></div>
    <div class="footer-bottom"><span>© {new Date().getFullYear()} Anders Aaboe Jensen</span><span>{profile.location}</span><div><a href={profile.linkedin} target="_blank" rel="noopener noreferrer">LinkedIn <Icon name="northeast" size={13}/></a><a href={withBase(profile.cv)} download>Download CV <Icon name="download" size={13}/></a><a href={withBase('/contact/')}>Contact</a></div></div>
  </div>
</footer>
