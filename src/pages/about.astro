---
import { withBase } from '../lib/urls';
import Base from '../layouts/Base.astro';
import { Image } from 'astro:assets';
import { portrait, tuDelftLogo, dtuLogo } from '../assets/general';
import Icon from '../components/Icon.astro';
import { profile } from '../data/profile';
const skills=[{name:'Analyse & simulate',tools:'Python, NumPy, JAX, PyTorch, MATLAB / Simulink, OpenFOAM',detail:'Numerical methods, turbulence modelling, CFD and scientific data analysis.'},{name:'Design & integrate',tools:'Onshape, SolidWorks, CAD, 3D printing, Arduino',detail:'Mechanical prototyping, manufacturing, sensors, pneumatic actuation and electronics.'},{name:'Measure & evaluate',tools:'Wind tunnels, PIV, hot wires, pressure measurement, engine dynamometers',detail:'Experimental setup, calibration, signal processing and comparison with numerical predictions.'}];
---
<Base title="About me">
  <section class="about-hero container"><div><p class="eyebrow">ABOUT ANDERS</p><h1>Curiosity, with<br/><span class="serif-word">a practical side.</span></h1><p class="lead">I’m an engineer who likes to understand a system, work through the physics, and get involved in building it.</p><p>My background spans Earth and Space Physics, Aerospace Engineering and Wind Energy. My projects connect numerical analysis with experiments, mechanical design and practical hardware.</p><p>That range began in the workshop: audio systems, electronics and engine maintenance and restoration with my father. It continues through vehicle engineering, research and the development of adaptive aerodynamic surfaces.</p><a class="text-link" href={withBase(profile.cv)} download>Download my CV <Icon name="download" size={18}/></a></div><figure class="portrait"><Image src={portrait} alt="Anders Aaboe Jensen" widths={[480, 800]} sizes="(max-width: 600px) 100vw, 530px" loading="eager"/><figcaption>Anders Aaboe Jensen <span>{profile.location}</span></figcaption></figure></section>
  <section class="section container education-section"><div class="section-heading"><div><p class="eyebrow">EDUCATION</p><h2>Physics as a foundation.<br/>Engineering as a practice.</h2></div></div><div class="education-grid"><article><div class="education-logo"><img src={tuDelftLogo.src} alt="TU Delft" class="logo-tud" width={tuDelftLogo.width} height={tuDelftLogo.height} loading="lazy"/></div><span class="eyebrow">2024–2026 / TU DELFT</span><h3>MSc Aerospace<br/>Engineering</h3><p>Aerodynamics, aeroelasticity, fluid–structure interaction and flow measurement techniques.</p><strong>Thesis: 9.0 / 10</strong></article><article><div class="education-logo"><img src={dtuLogo.src} alt="DTU — Technical University of Denmark" class="logo-dtu" width={dtuLogo.width} height={dtuLogo.height} loading="lazy"/></div><span class="eyebrow">2024–2026 / DTU</span><h3>MSc Wind<br/>Energy</h3><p>Wind turbine aerodynamics, turbulence modelling, CFD, advanced fluid mechanics, and machine and deep learning.</p><strong>Thesis: 12 / 12</strong></article><article><div class="education-logo"><img src={dtuLogo.src} alt="DTU — Technical University of Denmark" class="logo-dtu" width={dtuLogo.width} height={dtuLogo.height} loading="lazy"/></div><span class="eyebrow">2021–2024 / DTU</span><h3>BSc Earth & Space<br/>Physics and Engineering</h3><p>A foundation in physics, mathematics, electronics, data analysis and numerical methods.</p><strong>BSc project: 12 / 12</strong></article></div><p class="education-note">The two master’s degrees were completed in August 2026 through the European Wind Energy Master programme.</p></section>
  <section id="experience" class="experience-section"><div class="container"><div class="section-heading"><div><p class="eyebrow">EXPERIENCE</p><h2>Work with real hardware.<br/>Responsibility within a team.</h2></div><a class="text-link" href={withBase(profile.cv)} download>Full CV <Icon name="download" size={17}/></a></div><div class="experience-list"><article><div class="experience-date">Aug 2023 –<br/>Aug 2026</div><div><p class="eyebrow">DTU ROADRUNNERS</p><h3>Student Engineer</h3><p>DTU’s student vehicle team, which designs, builds and races highly efficient cars in international competitions. I worked in both of its teams, with team-lead responsibility in each.</p><div class="experience-team"><p class="eyebrow">ECOCAR · SHELL ECO-MARATHON</p><ul><li>Team lead for engine and combustion efficiency.</li><li>Engine optimisation through dynamometer testing and data analysis.</li><li>ECU calibration to maximise efficiency.</li><li>Race, energy and fuel-management strategy models in MATLAB/Simulink.</li><li>My engine and calibration work contributed to two consecutive 1st places in the EU Urban Concept ICE category: 413.83 km/l in 2024 and 517.5 km/l in 2025.</li></ul></div><div class="experience-team"><p class="eyebrow">SOLAR TEAM · BRIDGESTONE WORLD SOLAR CHALLENGE & ILUMEN EUROPEAN SOLAR CHALLENGE</p><ul><li>Team lead for the electrical drivetrain and cooling system.</li><li>Motor selection, performance modelling and design of a motor test stand.</li><li>Design, manufacture and load testing of the battery frame.</li><li>Camera-based side-view mirrors, developed with CFD and wind-tunnel testing as my BSc project.</li><li>Components designed to comply with UNECE vehicle regulations.</li></ul></div><div class="experience-links"><a class="text-link" href={withBase('/projects/roadrunners-powertrain/')}>Powertrain case study <Icon name="arrow" size={16}/></a><a class="text-link" href={withBase('/projects/?q=solar%20car')}>Solar Car projects <Icon name="arrow" size={16}/></a></div></div></article><article><div class="experience-date">Aug 2017 –<br/>May 2020</div><div><p class="eyebrow">FORCE TECHNOLOGY</p><h3>Technical Assistant</h3><p>Production of space-flight hardware for Europe’s heavy-lift launcher, Ariane 6, alongside work on condition monitoring for wind energy.</p><ul><li>Production of the rocket main-engine nozzles, including hardware for engine qualification and for the first three flights.</li><li>Laser welding and additive manufacturing of nozzle reinforcements.</li><li>Operator of a large 15-axis robot production cell, qualified by GKN Aerospace Engine Systems Sweden.</li><li>Assembly and installation of condition-monitoring sensor systems on wind turbines and offshore towers.</li></ul></div></article><article><div class="experience-date">Oct 2016 –<br/>Dec 2016</div><div><p class="eyebrow">KJUL & CO. APS</p><h3>Technical Assistant</h3><p>Assembly and testing of a specially designed giant mechanical watch with an open movement for Experimentarium, Copenhagen’s science centre, alongside daily workshop assistance.</p></div></article><article><div class="experience-date">Jul 2016 –<br/>Sep 2016</div><div><p class="eyebrow">FORCE TECHNOLOGY</p><h3>Technical NDT Assistant</h3><p>Assistant on X-ray inspection tasks on steel construction sites, power plants and district-heating pipes.</p></div></article></div></div></section>
  <section class="section container"><div class="section-heading"><div><p class="eyebrow">THE TOOLBOX</p><h2>Methods across disciplines.</h2></div></div><div class="skills-grid">{skills.map((s,i)=><article><span class="eyebrow">0{i+1}</span><h3>{s.name}</h3><p>{s.detail}</p><div>{s.tools}</div></article>)}</div></section>
  <section class="timeline-section container"><p class="eyebrow">BEYOND THE QUALIFICATIONS</p><h2>A thread through the projects.</h2><div class="personal-timeline"><article><span>2015–2017</span><h3>Build, wire, listen.</h3><p>Portable audio systems developed into a complete mobile PA, combining cabinets, DSP, batteries, solar integration and lighting.</p></article><article><span>2017–2021</span><h3>Make room for sound.</h3><p>Music production, mixing and mastering, with studio construction in 2019 and releases reaching more than three million streams.</p></article><article><span>2021–2026</span><h3>Connect theory to hardware.</h3><p>Physics, vehicle engineering and experimental aerodynamics, leading to dual MSc degrees and the DANSIS Graduate Award.</p></article></div><p class="personal-note">Away from the technical work, I enjoy sailing, skiing, sim racing, 3D printing, and keeping automotive and marine engines running.</p></section>
</Base>
