---
import { withBase } from '../lib/urls';
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import { portrait, tuDelftLogo, dtuLogo } from '../assets/general';
import thesisFeature from '../content/projects/adaptive-airfoil-flow-control/hero.jpg';
import Base from '../layouts/Base.astro';
import ProjectCard from '../components/ProjectCard.astro';
import ProjectDialogs from '../components/ProjectDialogs.astro';
import Icon from '../components/Icon.astro';
import { profile } from '../data/profile';
const projects = await getCollection('projects');
const featured = projects.filter(p=>p.data.featureOrder).sort((a,b)=>a.data.featureOrder!-b.data.featureOrder!);
---
<Base>
  <section class="hero container">
    <div class="hero-copy"><p class="eyebrow"><span class="small-cross" aria-hidden="true">+</span> RESEARCH. DESIGN. REAL SYSTEMS.</p><h1>Engineering from<br/>first principles to<br/><span class="serif-word">physical reality.</span></h1><p class="hero-description">I’m Anders. I combine numerical modelling, experimental research and hands-on development to understand, build and improve real systems.</p><div class="hero-actions"><a class="button button-dark" href={withBase('/projects/')}>Explore my work <Icon name="arrow"/></a><a class="text-link" href={withBase(profile.cv)} download>Download CV <Icon name="download" size={17}/></a></div><ul class="credential-list" aria-label="Degrees"><li><span class="credential-logo"><img src={tuDelftLogo.src} alt="TU Delft" class="logo-tud" width={tuDelftLogo.width} height={tuDelftLogo.height}/></span><span class="credential-text"><strong>MSc Aerospace Engineering</strong><span class="eyebrow">TU DELFT · 2024–2026</span></span></li><li><span class="credential-logo"><img src={dtuLogo.src} alt="DTU — Technical University of Denmark" class="logo-dtu" width={dtuLogo.width} height={dtuLogo.height}/></span><span class="credential-text"><strong>MSc Wind Energy</strong><span class="eyebrow">DTU · 2024–2026</span></span></li><li><span class="credential-logo"><img src={dtuLogo.src} alt="DTU — Technical University of Denmark" class="logo-dtu" width={dtuLogo.width} height={dtuLogo.height}/></span><span class="credential-text"><strong>BSc Earth & Space Physics and Engineering</strong><span class="eyebrow">DTU · 2021–2024</span></span></li></ul></div>
    <a class="hero-feature" href={withBase('/projects/adaptive-airfoil-flow-control/')} aria-label="Explore adaptive airfoil flow control">
      <div class="hero-feature-top"><span>01 / ADAPTIVE SURFACES</span><span class="status-dot" aria-hidden="true"></span></div>
      <Image class="hero-feature-image" src={thesisFeature} alt="" widths={[640, 1024]} sizes="(max-width: 600px) 100vw, 600px" loading="eager" fetchpriority="high"/>
      <div class="hero-feature-bottom"><div><span class="eyebrow">FEATURED RESEARCH · 2026</span><h2>A surface that<br/>adapts to the flow.</h2></div><span class="round-arrow"><Icon name="northeast" size={23}/></span></div>
    </a>
  </section>
  <section class="recognition-bar container" aria-label="Selected awards and achievements">
    <div><span class="recognition-symbol">01</span><p><strong>DANSIS Graduate Award 2026</strong><span>Best Fluid Mechanics Thesis</span></p></div>
    <div><span class="recognition-symbol">02</span><p><strong>DTU Blue Dot Diploma Award 2024</strong><span>Outstanding contribution to student-driven projects</span></p></div>
    <div><span class="recognition-symbol">03</span><p><strong>Shell Eco-marathon 1st Place 2024 & 2025</strong><span>Urban Concept ICE, with DTU RoadRunners</span></p></div>
  </section>
  <section class="section container" aria-labelledby="selected-work">
    <div class="section-heading"><div><p class="eyebrow">SELECTED WORK / 01—06</p><h2 id="selected-work">Different systems.<br/>The same engineering curiosity.</h2></div><a class="text-link" href={withBase('/projects/')}>All {projects.length} projects <Icon name="arrow"/></a></div>
    <div class="project-grid featured-grid">{featured.map(project=><ProjectCard project={project} featured/>)}</div>
  </section>
  <section class="approach-section"><div class="container"><div class="section-heading"><div><p class="eyebrow">HOW I WORK</p><h2>Understanding is the start.<br/>Making it work is the point.</h2></div><p class="section-aside">My projects connect the mathematical model, the experiment and the physical system.</p></div><div class="approach-grid"><div><span>01 / ANALYSE</span><h3>Start with the physics.</h3><p>Numerical solvers, CFD and scientific computing to investigate the mechanisms and evaluate design choices.</p><small>Python · OpenFOAM · MATLAB / Simulink</small></div><div><span>02 / BUILD</span><h3>Give the idea a form.</h3><p>CAD, fabrication, electronics and system integration, from adjustable airfoil surfaces to vehicle hardware.</p><small>Onshape · 3D printing · Arduino</small></div><div><span>03 / MEASURE</span><h3>Put the model to the test.</h3><p>Instrumentation and experiments that connect predictions to observed behaviour, with clear limits on the conclusions.</p><small>Wind tunnels · PIV · Dynamometer testing</small></div></div></div></section>
  <section class="about-preview container"><div class="about-preview-image"><Image src={portrait} alt="Anders Aaboe Jensen" widths={[220, 440]} sizes="220px"/></div><div><p class="eyebrow">THE ENGINEER BEHIND THE WORK</p><h2>From the workshop<br/>to the wind tunnel.</h2><p>I started by building audio systems. That practical curiosity grew into vehicle engineering, experimental physics, and two master’s degrees. I’m interested in what happens when analysis and hands-on work meet.</p><a class="text-link" href={withBase('/about/')}>More about me <Icon name="arrow"/></a></div><span class="about-coordinate" aria-hidden="true">BASED IN<br/>DENMARK ↗</span></section>
  <ProjectDialogs projects={featured}/>
</Base>
